library (cells) {
  cell (AND2) {
    pin (A) {
      direction : input;
    }
    pin (B) {
      direction : input;
    }
    pin (Y) {
      direction : output;
      function : "A*B";
    }
  }
  cell (C2) {
    pin (A) {
      direction : input;
    }
    pin (B) {
      direction : input;
    }
    statetable ("A B", "Q_st") {
      table : "L L : - : L , \
               L H : - : N , \
               H L : - : N , \
               H H : - : H";
    }
    pin (Q) {
      direction : output;
      internal_node : "Q_st";
      inverted_output : false;
    }
  }
  cell (RCELEM2) {
    pin (A) {
      direction : input;
    }
    pin (B) {
      direction : input;
    }
    pin (R) {
      direction : input;
    }
    statetable ("A B R", "Q_st") {
      table : "- - H : - : L , \
               L L - : - : L , \
               L H L : - : N , \
               H L L : - : N , \
               H H L : - : H";
    }
    pin (Q) {
      direction : output;
      internal_node : "Q_st";
      inverted_output : false;
    }
  }
  cell (RACELEM21) {
    pin (M1) {
      direction : input;
    }
    pin (M2) {
      direction : input;
    }
    pin (P1) {
      direction : input;
    }
    pin (P2) {
      direction : input;
    }
    pin (C) {
      direction : input;
    }
    pin (R) {
      direction : input;
    }
    statetable ("M1 M2 P1 P2 C R", "Q_st") {
      table : "- - - - - H : - : L , \
               - H - - L L : - : N , \
               L L - - L - : - : L , \
               H - - - L L : - : N , \
               - - - L H L : - : N , \
               - - L - H L : - : N , \
               - - H H H L : - : H";
    }
    pin (Q) {
      direction : output;
      internal_node : "Q_st";
      inverted_output : false;
    }
  }
  /* oscillation: !S*!R risks metastability in Q, Qn, settling to one of {Q=0, Qn=1} | {Q=1, Qn=0} */
  cell (SR) {
    pin (S) {
      direction : input;
    }
    pin (R) {
      direction : input;
    }
    statetable ("S R", "Q_st Qn_st") {
      table : "H - : - - : - L , \
               - H : - - : L - , \
               - L : - L : H - , \
               - - : - H : L - , \
               L - : L - : - H , \
               - - : H - : - L";
    }
    pin (Q) {
      direction : output;
      internal_node : "Q_st";
      inverted_output : false;
    }
    pin (Qn) {
      direction : output;
      internal_node : "Qn_st";
      inverted_output : false;
    }
  }
  /* oscillation: A*B risks metastability in Qa, Qb, settling to one of {Qa=0, Qb=1} | {Qa=1, Qb=0} */
  cell (MUT) {
    pin (A) {
      direction : input;
    }
    pin (B) {
      direction : input;
    }
    statetable ("A B", "Qa_st Qb_st") {
      table : "- - : - H : L - , \
               - - : H - : - L , \
               - L : - - : - L , \
               - H : L - : - H , \
               L - : - - : L - , \
               H - : - L : H -";
    }
    pin (Qa) {
      direction : output;
      internal_node : "Qa_st";
      inverted_output : false;
    }
    pin (Qb) {
      direction : output;
      internal_node : "Qb_st";
      inverted_output : false;
    }
  }
  cell (DFF) {
    pin (CLK) {
      direction : input;
    }
    pin (D) {
      direction : input;
    }
    statetable ("CLK D", "Q_st M") {
      table : "L - : - - : N - , \
               L L : - - : - L , \
               L H : - - : - H , \
               H - : - - : - N , \
               H - : - L : L - , \
               H - : - H : H -";
    }
    pin (Q) {
      direction : output;
      internal_node : "Q_st";
      inverted_output : false;
    }
    pin (M) {
      direction : internal;
      internal_node : "M";
    }
  }
  cell (ICM) {
    pin (CLKA) {
      direction : input;
    }
    pin (CLKB) {
      direction : input;
    }
    pin (RA) {
      direction : input;
    }
    pin (RB) {
      direction : input;
    }
    pin (S) {
      direction : input;
    }
    statetable ("CLKA CLKB RA RB S", "enA enB sela1 sela2 selb1 selb2") {
      table : "- - - H - : - - - - - - : - L - - L L , \
               - - H - - : - - - - - - : L - L L - - , \
               - L - - - : - - - - - L : - L - - - - , \
               - L - - - : H - - - - - : - - - - L - , \
               - L - - L : - - - - - - : - - - - L - , \
               - L - L - : - - - - - - : - - - - - N , \
               - L - L - : - - - - - H : - H - - - - , \
               - L - L H : L - - - - - : - - - - H - , \
               - H - - - : - - - - L - : - - - - - L , \
               - H - L - : - - - - - - : - N - - N - , \
               - H - L - : - - - - H - : - - - - - H , \
               L - - - - : - - - L - - : L - - - - - , \
               L - - - - : - H - - - - : - - L - - - , \
               L - - - H : - - - - - - : - - L - - - , \
               L - L - - : - - - - - - : - - - N - - , \
               L - L - - : - - - H - - : H - - - - - , \
               L - L - L : - L - - - - : - - H - - - , \
               H - - - - : - - L - - - : - - - L - - , \
               H - L - - : - - - - - - : N - N - - - , \
               H - L - - : - - H - - - : - - - H - -";
    }
    pin (GCLK) {
      direction : output;
      state_function : "enB*CLKB + enA*CLKA";
    }
    pin (enA) {
      direction : internal;
      internal_node : "enA";
    }
    pin (enB) {
      direction : internal;
      internal_node : "enB";
    }
    pin (sela1) {
      direction : internal;
      internal_node : "sela1";
    }
    pin (sela2) {
      direction : internal;
      internal_node : "sela2";
    }
    pin (selb1) {
      direction : internal;
      internal_node : "selb1";
    }
    pin (selb2) {
      direction : internal;
      internal_node : "selb2";
    }
  }
  cell (C2GATE) {
    pin (A) {
      direction : input;
    }
    pin (B) {
      direction : input;
    }
    statetable ("A B", "Q_st") {
      table : "L L : - : L , \
               L H : - : N , \
               H L : - : N , \
               H H : - : H";
    }
    pin (Q) {
      direction : output;
      internal_node : "Q_st";
      inverted_output : false;
    }
  }
}
