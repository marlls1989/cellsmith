library (cells) {
  cell (AND2) {
    pin (A) {
      direction : input;
    }
    pin (B) {
      direction : input;
    }
    pin (Y) {
      direction : output;
      function : "A*B";
    }
  }
  cell (C2) {
    pin (A) {
      direction : input;
    }
    pin (B) {
      direction : input;
    }
    statetable ("A B", "Q") {
      table : "H H : - : H , H L : - : N , L H : - : N , L L : - : L";
    }
    pin (Q) {
      direction : output;
      function : "Q";
    }
  }
  cell (RCELEM2) {
    pin (A) {
      direction : input;
    }
    pin (B) {
      direction : input;
    }
    pin (R) {
      direction : input;
    }
    statetable ("A B R", "Q") {
      table : "- - H : - : L , H H L : - : H , H L L : - : N , L H L : - : N , L L - : - : L";
    }
    pin (Q) {
      direction : output;
      function : "Q";
    }
  }
  cell (RACELEM21) {
    pin (M1) {
      direction : input;
    }
    pin (M2) {
      direction : input;
    }
    pin (P1) {
      direction : input;
    }
    pin (P2) {
      direction : input;
    }
    pin (C) {
      direction : input;
    }
    pin (R) {
      direction : input;
    }
    statetable ("P1 P2 C R M1 M2", "Q") {
      table : "- - - H - - : - : L , - - L - L L : - : L , - - L L - H : - : N , - - L L H - : - : N , - L H L - - : - : N , H H H L - - : - : H , L - H L - - : - : N";
    }
    pin (Q) {
      direction : output;
      function : "Q";
    }
  }
  /* arbitration: !S*!R metastable; grants Q, Qn mutually exclusive (both-high forbidden) */
  cell (SR) {
    pin (S) {
      direction : input;
    }
    pin (R) {
      direction : input;
    }
    pin (Q) {
      direction : output;
      function : "!R*!Qn";
    }
    pin (Qn) {
      direction : output;
      function : "!S*!Q";
    }
  }
  /* arbitration: A*B metastable; grants Qa, Qb mutually exclusive (both-high forbidden) */
  cell (MUT) {
    pin (A) {
      direction : input;
    }
    pin (B) {
      direction : input;
    }
    pin (Qa) {
      direction : output;
      function : "!Qb*A";
    }
    pin (Qb) {
      direction : output;
      function : "!Qa*B";
    }
  }
  cell (DFF) {
    pin (CLK) {
      direction : input;
    }
    pin (D) {
      direction : input;
    }
    statetable ("CLK M", "Q") {
      table : "H H : - : H , H L : - : L , L - : - : N";
    }
    pin (Q) {
      direction : output;
      function : "Q";
    }
    statetable ("CLK D", "M") {
      table : "H - : - : N , L H : - : H , L L : - : L";
    }
    pin (M) {
      direction : internal;
      function : "M";
    }
  }
  cell (ICM) {
    pin (CLKA) {
      direction : input;
    }
    pin (CLKB) {
      direction : input;
    }
    pin (RA) {
      direction : input;
    }
    pin (RB) {
      direction : input;
    }
    pin (S) {
      direction : input;
    }
    pin (GCLK) {
      direction : output;
      function : "enB*CLKB + enA*CLKA";
    }
    statetable ("CLKA RA sela2", "enA") {
      table : "- H - : - : L , H L - : - : N , L - L : - : L , L L H : - : H";
    }
    pin (enA) {
      direction : internal;
      function : "enA";
    }
    statetable ("CLKB RB selb2", "enB") {
      table : "- H - : - : L , H L - : - : N , L - L : - : L , L L H : - : H";
    }
    pin (enB) {
      direction : internal;
      function : "enB";
    }
    statetable ("CLKA RA enB S", "sela1") {
      table : "- H - - : - : L , H L - - : - : N , L - - H : - : L , L - H - : - : L , L L L L : - : H";
    }
    pin (sela1) {
      direction : internal;
      function : "sela1";
    }
    statetable ("CLKA RA sela1", "sela2") {
      table : "- H - : - : L , H - L : - : L , H L H : - : H , L L - : - : N";
    }
    pin (sela2) {
      direction : internal;
      function : "sela2";
    }
    statetable ("enA CLKB RB S", "selb1") {
      table : "- - H - : - : L , - H L - : - : N , - L - L : - : L , H L - - : - : L , L L L H : - : H";
    }
    pin (selb1) {
      direction : internal;
      function : "selb1";
    }
    statetable ("CLKB RB selb1", "selb2") {
      table : "- H - : - : L , H - L : - : L , H L H : - : H , L L - : - : N";
    }
    pin (selb2) {
      direction : internal;
      function : "selb2";
    }
  }
  cell (C2GATE) {
    pin (A) {
      direction : input;
    }
    pin (B) {
      direction : input;
    }
    statetable ("A B", "Q") {
      table : "H H : - : H , H L : - : N , L H : - : N , L L : - : L";
    }
    pin (Q) {
      direction : output;
      function : "Q";
    }
  }
}
