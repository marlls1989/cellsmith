library (cells) {
  cell (AND2) {
    pin (A) {
      direction : input;
    }
    pin (B) {
      direction : input;
    }
    pin (Y) {
      direction : output;
      function : "A*B";
    }
  }
  cell (C2) {
    pin (A) {
      direction : input;
    }
    pin (B) {
      direction : input;
    }
    statetable ("A B", "Q") {
      table : "L L : - : L , \
               L H : - : N , \
               H L : - : N , \
               H H : - : H";
    }
    pin (Q) {
      direction : output;
      internal_node : "Q";
    }
  }
  cell (RCELEM2) {
    pin (A) {
      direction : input;
    }
    pin (B) {
      direction : input;
    }
    pin (R) {
      direction : input;
    }
    statetable ("A B R", "Q") {
      table : "- - H : - : L , \
               L L - : - : L , \
               L H L : - : N , \
               H L L : - : N , \
               H H L : - : H";
    }
    pin (Q) {
      direction : output;
      internal_node : "Q";
    }
  }
  cell (RACELEM21) {
    pin (M1) {
      direction : input;
    }
    pin (M2) {
      direction : input;
    }
    pin (P1) {
      direction : input;
    }
    pin (P2) {
      direction : input;
    }
    pin (C) {
      direction : input;
    }
    pin (R) {
      direction : input;
    }
    statetable ("M1 M2 P1 P2 C R", "Q") {
      table : "- - - - - H : - : L , \
               - H - - L L : - : N , \
               L L - - L - : - : L , \
               H - - - L L : - : N , \
               - - - L H L : - : N , \
               - - L - H L : - : N , \
               - - H H H L : - : H";
    }
    pin (Q) {
      direction : output;
      internal_node : "Q";
    }
  }
  /* oscillation: !S*!R risks metastability in Q, Qn, settling to one of {Q=0, Qn=1} | {Q=1, Qn=0} */
  cell (SR) {
    pin (S) {
      direction : input;
    }
    pin (R) {
      direction : input;
    }
    statetable ("S R", "Q Qn") {
      table : "H - : - - : - L , \
               - H : - - : L - , \
               - L : - L : H - , \
               - - : - H : L - , \
               L - : L - : - H , \
               - - : H - : - L";
    }
    pin (Q) {
      direction : output;
      internal_node : "Q";
    }
    pin (Qn) {
      direction : output;
      internal_node : "Qn";
    }
  }
  /* oscillation: A*B risks metastability in Qa, Qb, settling to one of {Qa=0, Qb=1} | {Qa=1, Qb=0} */
  cell (MUT) {
    pin (A) {
      direction : input;
    }
    pin (B) {
      direction : input;
    }
    statetable ("A B", "Qa Qb") {
      table : "- - : - H : L - , \
               - - : H - : - L , \
               - L : - - : - L , \
               - H : L - : - H , \
               L - : - - : L - , \
               H - : - L : H -";
    }
    pin (Qa) {
      direction : output;
      internal_node : "Qa";
    }
    pin (Qb) {
      direction : output;
      internal_node : "Qb";
    }
  }
  cell (DFF) {
    pin (CLK) {
      direction : input;
    }
    pin (D) {
      direction : input;
    }
    statetable ("CLK D", "Q") {
      table : "R H : - : H , \
               R L : - : L , \
               ~R - : - : N";
    }
    pin (Q) {
      direction : output;
      internal_node : "Q";
    }
  }
  cell (DLH) {
    pin (G) {
      direction : input;
    }
    pin (D) {
      direction : input;
    }
    statetable ("G D", "Q") {
      table : "L - : - : N , \
               H L : - : L , \
               H H : - : H";
    }
    pin (Q) {
      direction : output;
      internal_node : "Q";
    }
  }
  cell (ICM) {
    pin (CLKA) {
      direction : input;
    }
    pin (CLKB) {
      direction : input;
    }
    pin (RA) {
      direction : input;
    }
    pin (RB) {
      direction : input;
    }
    pin (S) {
      direction : input;
    }
    statetable ("CLKA CLKB RA RB S", "enA enB sela2 selb2") {
      table : "F - L - - : - - H - : H - - - , \
               F - - - - : - - L - : L - - - , \
               F - H - - : - - - - : L - - - , \
               ~F - H - - : - - - - : L - - - , \
               ~F - L - - : - - - - : N - - - , \
               - F - L - : - - - H : - H - - , \
               - F - - - : - - - L : - L - - , \
               - F - H - : - - - - : - L - - , \
               - ~F - H - : - - - - : - L - - , \
               - ~F - L - : - - - - : - N - - , \
               R - L - L : - L - - : - - H - , \
               R - - - H : - - - - : - - L - , \
               R - H - - : - - - - : - - L - , \
               R - - - - : - H - - : - - L - , \
               ~R - H - - : - - - - : - - L - , \
               ~R - L - - : - - - - : - - N - , \
               - R - L H : L - - - : - - - H , \
               - R - - L : - - - - : - - - L , \
               - R - H - : - - - - : - - - L , \
               - R - - - : H - - - : - - - L , \
               - ~R - H - : - - - - : - - - L , \
               - ~R - L - : - - - - : - - - N";
    }
    pin (GCLK) {
      direction : output;
      state_function : "enB*CLKB + enA*CLKA";
    }
    pin (enA) {
      direction : internal;
      internal_node : "enA";
    }
    pin (enB) {
      direction : internal;
      internal_node : "enB";
    }
    pin (sela2) {
      direction : internal;
      internal_node : "sela2";
    }
    pin (selb2) {
      direction : internal;
      internal_node : "selb2";
    }
  }
  cell (C2GATE) {
    pin (A) {
      direction : input;
    }
    pin (B) {
      direction : input;
    }
    statetable ("A B", "Q") {
      table : "L L : - : L , \
               L H : - : N , \
               H L : - : N , \
               H H : - : H";
    }
    pin (Q) {
      direction : output;
      internal_node : "Q";
    }
  }
}
